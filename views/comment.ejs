<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments</title>
    <link rel="stylesheet" href="/src/shared.css">
    <link rel="stylesheet" href="/src/userHome.css">
    <link rel="stylesheet" href="/src/main.css">
    <style>

        .search-bar h2{
            text-align: center; position:relative; bottom:7px;
        }
        @media (max-width: 600px) {
            .search-bar h2{
                position: relative;
                bottom:0;
            }
        }

        /* Comments page styles */
        .comments-container {
            max-width: 800px;
            margin: 1.5rem auto 7rem auto;
            padding: 0 1rem;
        }

        .comments-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .comment-card {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            color: green;
            font-weight: bold;
        }

        .comment-body {
            flex: 1;
        }

        .comment-username {
            margin: 0 0 .25rem 0;
            color: #fff;
            font-weight: 600;
        }

        .comment-text {
            margin: 0;
            color: #f1f1f1;
        }

        @media (max-width: 600px){
            .avatar { width: 38px; height: 38px; }
        }
    </style>



    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

    <nav  class="nav">
            <div  style="background-color: white; z-index:1000;" class="first-nav">
                <div class="three-dash item" ><i class="fa-solid fa-bars"></i></div>
                <div class="title item" >Guzo</div>
            </div>
           
            <div  style="z-index:1000;" class="search-bar item">
                <h2  >comments</h2>
             </div>

            <div style="z-index:1000;" class="second-nav">
                    <div class="notification item"><a href="notifications"> <i class="fa-solid fa-bell notification-bar"></i></a></div>
                    <div class="user-container item"><a href="profile"> <i class="fa-solid fa-bus user"></i></a>
                    <div class="name-container item"> <a href="profile"> <h3 class="user">Bus Station<br> Name</h3></a></div>
            </div>
                    
                </div>
            </div>
   

        </nav>
    </header>

    <div class="side-bar">
        <div class="side-bar-container">
            <div class="routes sid-option"><a href="home"><p>Home</p></a></div>
             <div class="route sid-option"><a href="comments"><p>Comments</p></a></div>
            <div class="settings sid-option"><p>Settings</p></div>
            <div class="About sid-option"><a href="about"><p>About</p></a></div>
            <div class="Logout sid-option"><a href="logout"><p>Logout</p></a></div>
        </div>
    </div>
    <main class="container comments-container">
        <section class="comments-list">
            <% (comments || []).forEach(function(c){ %>
                <article class="card comment-card">
                    <div class="avatar"><%= c.username ? c.username.charAt(0).toUpperCase() : '?' %></div>
                    <div class="comment-body">
                        <h4 class="comment-username"><%= c.username %></h4>
                        <p class="comment-text"><%= c.text %></p>
                    </div>
                </article>
            <% }) %>
            <% if (!comments || comments.length === 0) { %>
                <article class="card" style="text-align:center;">
                    <p>No comments yet.</p>
                </article>
            <% } %>
        </section>
    </main>
    
    
    <div class="footer">
        <p>
            &copy; Developed By 
            <a style="color:black;" href="https://portfolio-5blt.onrender.com/">Honelign</a>
        </p>
    </div> 
<script src="/src/userHome.js"></script>
</body>
</html>